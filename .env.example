# =====================================================================
# Califa ERP — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local ou qualquer arquivo com secrets reais.
# =====================================================================

# ------- Supabase (público, exposto no browser) -------
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# ------- Supabase (servidor apenas — NUNCA no client) -------
# Usada por Server Actions/Route Handlers para operações administrativas
# (criação de usuário, atribuição de tenant_member, etc).
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# ------- Tenant padrão do MVP -------
# Slug do tenant inicial (seed) para operações que ainda não têm seletor.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=agencia-california

# ---------------------------------------------------------------------
# Supabase MCP (ferramentas de desenvolvimento — não usadas pelo app)
# Usada pelo .mcp.json para permitir que assistentes de IA (Claude Code
# etc.) apliquem migrations, inspecionem tabelas e rodem SQL.
# Só precisa configurar se você for usar MCP localmente.
# O project-ref já está fixado no .mcp.json (não é secret).
# Para carregar em PowerShell: $env:SUPABASE_ACCESS_TOKEN="..."
# ---------------------------------------------------------------------
# Personal Access Token (Supabase Dashboard → Account → Tokens)
SUPABASE_ACCESS_TOKEN=<supabase-personal-access-token>
